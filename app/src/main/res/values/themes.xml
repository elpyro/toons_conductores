<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ToonsConductor" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/rojo</item>
        <item name="colorPrimaryVariant">@color/white</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorSecondary">@color/black</item>
        <item name="colorSecondaryVariant">@color/rojo</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="colorControlActivated">@color/white</item>
        <item name="colorControlHighlight">@color/white</item>
        <item name="android:textColorHint">@color/white</item>
    </style>

    <style name="Theme.ToonsConductor" parent="Base.Theme.ToonsConductor" />

    <style name="EditTextGrey" parent="TextAppearance.AppCompat">
        <item name="colorControlNormal">@color/grey_dark</item>
        <item name="colorControlActivated">@color/grey_dark</item>
        <item name="colorControlHighlight">@color/grey_dark</item>
        <item name="android:textColorHint">@color/grey_dark</item>
        <item name="colorAccent">@color/grey_dark</item>
        <item name="android:textColorPrimary">@color/grey_dark</item>
        <item name="colorSecondary">@color/grey_dark</item>
        <item name="colorOnPrimary">@color/grey_dark</item>
    </style>
</resources>