<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.saldo.Saldo">

    <ImageView
        android:id="@+id/imagen_saldo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerHorizontal="true"
        android:src="@drawable/ic_saldo" />

    <TextView
        android:id="@+id/titulo_saldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/imagen_saldo"
        android:layout_centerHorizontal="true"
        android:text="Saldo Actual"
        android:textSize="24sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/saldo_actual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/titulo_saldo"
        android:layout_centerHorizontal="true"
        android:text="100$"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

    <Button
        android:id="@+id/boton_recargar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/saldo_actual"
        android:layout_marginTop="32dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:text="Recargar Saldo"
        android:background="@drawable/boton_redondo"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

</RelativeLayout>