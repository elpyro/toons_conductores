<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activitys.mapTripActivity.MapTripActivity">

    <fragment
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:name="com.google.android.gms.maps.SupportMapFragment" />

    <LinearLayout
        android:id="@+id/Linear_compartir_ruta"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_gravity="start"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView_Waze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ico_waze"
            android:layout_margin="4dp"
            android:contentDescription="Waze" />

        <ImageView
            android:id="@+id/imageView_google_maps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:src="@drawable/ico_google_maps"
            android:contentDescription="Google Maps" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:visibility="gone"
        android:id="@+id/tiempoRecorrido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:layout_marginTop="100dp"
        android:layout_gravity="center_horizontal"
        app:cardCornerRadius="8dp"
        android:elevation="8dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="8dp"
            android:gravity="center"
            android:layout_gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiempo: "
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    />

                <TextView
                    android:id="@+id/textViewTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recorrido: "
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    />

                <TextView
                    android:id="@+id/textViewDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 Km"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>




    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginRight="70dp"
    android:layout_marginLeft="70dp"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">
        <Button

            android:id="@+id/btnStartTrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir a punto de encuentro"
            android:backgroundTint="@color/rojoClaro1"
            android:background="@drawable/rounded_button"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnHellegado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="He llegado"
            android:backgroundTint="@color/rojoClaro2"
            android:background="@drawable/rounded_button"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnInciarViaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar Viaje"
            android:backgroundTint="@color/rojoClaro3"
            android:background="@drawable/rounded_button"

            android:visibility="gone"/>

        <Button
            android:id="@+id/btnFinishTrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FINALIZAR VIAJE"
            android:backgroundTint="@color/rojoClaro4"
            android:background="@drawable/rounded_button"

            android:visibility="gone"/>

    <ImageView
        android:visibility="gone"
        android:layout_marginTop="20dp"
        android:layout_gravity="center"
        android:id="@+id/imageViewInfo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/baseline_info_24" />
</LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>