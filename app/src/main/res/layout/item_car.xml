<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">

    <LinearLayout
        android:id="@+id/linearLayoutCar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginTop="5dp">

            <ImageView
                android:id="@+id/imageView_car"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_paralel_car_red" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1"
                android:layout_marginLeft="15dp">

                <TextView
                    android:id="@+id/textview_placaymodelo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Placa y modelo"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/textViewEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado"
                    android:textSize="15sp"/>

            </LinearLayout>

            <ImageView
                android:id="@+id/imageView_cambiar"
                android:layout_width="80dp"
                android:layout_height="60dp"
                android:padding="10dp"
                app:srcCompat="@drawable/ic_cambiar" />

        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>